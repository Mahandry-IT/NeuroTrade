# ══════════════════════════════════════════════
# Trading Bot IA — Backend — Variables d'env
# Copier ce fichier en .env et remplir les valeurs
# ══════════════════════════════════════════════

# ── Database ──
DATABASE_URL=postgresql://trading_bot:trading_bot_pass@localhost:5432/trading_bot

# ── Gemini AI (free tier) ──
GEMINI_API_KEY=

# ── Sécurité ──
# Générer avec: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION

# ── SMTP (optionnel — email notifications) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Trading Platform ──
TRADING_PLATFORM_API_KEY=
TRADING_PLATFORM_API_SECRET=
